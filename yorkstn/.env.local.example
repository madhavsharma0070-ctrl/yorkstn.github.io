NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here

# --- Yorkstn platform (added Phase 4) ---
# Local dev: SQLite, zero setup required. Staging/production: point at a real
# Postgres instance (see docs/phase2/DEPLOYMENT_ARCHITECTURE.md §8).
DATABASE_URL="file:./dev.db"

# NextAuth.js / Auth.js. Generate a real secret for anything beyond local dev:
# `openssl rand -base64 32`
NEXTAUTH_SECRET=dev-only-insecure-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# AI service layer (docs/phase2/AI_ARCHITECTURE.md). "mock" requires no credentials
# and is fully functional for MVP demo purposes. Set to "anthropic" + provide
# ANTHROPIC_API_KEY to enable real generative output.
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=

# Document storage (docs/phase2/SECURITY_ARCHITECTURE.md). "local" writes to
# .local-storage/ on disk (dev only, gitignored). Set to "s3" + provide the AWS_*
# vars above (already used for SES) plus a bucket name for staging/production.
DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_S3_BUCKET=
